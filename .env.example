# ─────────────────────────────────────────────────────────────────────────────
# VolPulse environment contract.
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored. Never commit real credentials.
# Every variable here MUST be read through the config layer
# (libs/py-core -> volpulse.config), never via os.environ directly
# in business logic.
# ─────────────────────────────────────────────────────────────────────────────

# ── Data source: IVolatility ───────────────────────────────────────────────
IVOL_API_KEY="4y7Xr93JGI76le51">
IVOL_BASE_URL=https://api.ivolatility.com
IVOL_TIMEOUT_SECONDS=30
# Subscription quota: max ~1 request/sec. Keep >= 1.0.
IVOL_RATE_LIMIT_RPS=1.0
IVOL_MAX_CONCURRENCY=4

# ── Message broker (Kafka / BlazingMQ) ─────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_OPTIONS=options.chain.streaming
KAFKA_TOPIC_QUOTES=options.quotes.realtime
KAFKA_CONSUMER_GROUP=volpulse-analytics
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# ── Time-series store (TimescaleDB) ────────────────────────────────────────
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_DB=volpulse
TIMESCALE_USER=volpulse
TIMESCALE_PASSWORD=<local_dev_password>

# ── Relational store (PostgreSQL: portfolio + system state) ────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=volpulse_state
POSTGRES_USER=volpulse
POSTGRES_PASSWORD=<local_dev_password>

# ── Observability ──────────────────────────────────────────────────────────
PROMETHEUS_URL=http://localhost:9090
PUSHGATEWAY_URL=http://localhost:9091
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=<local_dev_token>
INFLUXDB_ORG=volpulse
INFLUXDB_BUCKET=metrics
SENSU_URL=http://localhost:8080
SENSU_NAMESPACE=volpulse

# ── Dependency proxy (Artifactory) ─────────────────────────────────────────
ARTIFACTORY_URL=http://localhost:8081
ARTIFACTORY_PYPI_REPO=api/pypi/pypi
ARTIFACTORY_READER_USER=reader
ARTIFACTORY_READER_PASSWORD=<local_dev_password>

# ── Service runtime ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
BINARY_LOG_DIR=var/binary-logs
CHECKPOINT_DIR=var/checkpoints
ARTIFACT_DIR=var/artifacts
